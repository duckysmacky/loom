# Postgres connection. DB_HOST is "database" when using the compose database
DB_HOST=database
DB_PORT=5432
DB_NAME=loom
DB_USER=loom
DB_PASSWORD=change-me

# Only used for compile-time verification. Keep this in sync with the DB_* vars
DATABASE_URL=postgres://loom:change-me@localhost:5432/loom

# Ports the backend/frontend are published on
BACKEND_PORT=8080
FRONTEND_PORT=8081

# Image tag pulled by `docker compose up`. Pin to a release (e.g. "0.1.0")
# for a stable deploy; "latest" tracks the newest push to master.
LOOM_VERSION=latest

# Address the backend binds to inside its container. Only change this if
# you're running the binary directly outside Docker.
BIND_ADDR=0.0.0.0:8080

# Logging
RUST_LOG=info

# Signs/verifies JWT access tokens. Must be at least 32 bytes
JWT_SECRET=change-me

# Whether POST /api/auth/signup accepts new accounts
ALLOW_SIGNUP=true

# Optional MCP server for AI agents (Claude, other MCP clients). Off unless "true"
MCP_ENABLED=false

# Public origin Loom is served at, e.g. https://loom.example.com (no path,
# no trailing slash). Required when MCP_ENABLED=true
PUBLIC_URL=
