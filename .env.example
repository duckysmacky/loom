# Postgres connection. DB_HOST is "database" when using the bundled
# `docker compose up` database, or "localhost"/a remote host otherwise.
DB_HOST=database
DB_PORT=5432
DB_USER=loom
DB_PASSWORD=change-me
DB_NAME=loom

# Only read by sqlx-cli / compile-time query! macros (cargo sqlx prepare).
# No variable expansion in .env files - keep this in sync with the DB_* vars
# above by hand.
DATABASE_URL=postgres://loom:change-me@localhost:5432/loom

# Ports the backend/frontend are published on when run via `docker compose up`.
BACKEND_PORT=8080
FRONTEND_PORT=8081

# Image tag pulled by `docker compose up`. Pin to a release (e.g. "0.1.0")
# for a stable deploy; "latest" tracks the newest push to master.
LOOM_VERSION=latest

# Address the backend binds to inside its container. Only change this if
# you're running the binary directly outside Docker.
BIND_ADDR=0.0.0.0:8080

RUST_LOG=info

# Signs/verifies JWT access tokens. Generate with `openssl rand -hex 32`.
# Must be at least 32 bytes - the app refuses to start otherwise.
JWT_SECRET=change-me

# Whether POST /api/auth/signup accepts new accounts. Leave true for the
# first run, then set to false once your account exists - single-user app,
# no reason to leave account creation open.
ALLOW_SIGNUP=true
