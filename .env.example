# Postgres connection. DB_HOST is "postgres" when using the bundled
# `docker compose up` database, or "localhost"/a remote host otherwise.
DB_HOST=postgres
DB_PORT=5432
DB_USER=loom
DB_PASSWORD=change-me
DB_NAME=loom

# Only read by sqlx-cli / compile-time query! macros (cargo sqlx prepare).
# No variable expansion in .env files - keep this in sync with the DB_* vars
# above by hand.
DATABASE_URL=postgres://loom:change-me@localhost:5432/loom

# Port the app is published on when run via `docker compose up`.
APP_PORT=8080

RUST_LOG=info

# Signs/verifies JWT access tokens. Generate with `openssl rand -hex 32`.
# Must be at least 32 bytes - the app refuses to start otherwise.
JWT_SECRET=change-me

# Whether POST /api/auth/signup accepts new accounts. Leave true for the
# first run, then set to false once your account exists - single-user app,
# no reason to leave account creation open.
ALLOW_SIGNUP=true
