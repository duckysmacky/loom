  "query": "\n        INSERT INTO active_periods (node_id, started_at, ended_at, focus)\n        SELECT n.id, $3, $4, $5\n        FROM nodes n\n        WHERE n.id = $2 AND n.user_id = $1\n        RETURNING id, node_id, started_at, ended_at, focus AS \"focus: NodeFocus\"\n        ",
