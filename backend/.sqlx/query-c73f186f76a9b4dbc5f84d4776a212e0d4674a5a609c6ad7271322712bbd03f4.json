  "query": "\n        UPDATE topics SET\n            name = COALESCE($3, name),\n            color = CASE WHEN $4 THEN $5 ELSE color END,\n            updated_at = now()\n        WHERE user_id = $1 AND id = $2\n        RETURNING id, name, color, created_at, updated_at\n        ",
