  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.id, a.node_id, a.started_at, a.ended_at\n        FROM active_periods a\n        JOIN nodes n ON n.id = a.node_id\n        WHERE n.user_id = $1 AND a.node_id = $2\n        ORDER BY a.started_at, a.id\n        ",
