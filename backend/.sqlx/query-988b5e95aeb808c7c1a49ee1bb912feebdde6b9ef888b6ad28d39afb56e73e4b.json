{
  "db_name": "PostgreSQL",
  "query": "\n        UPDATE checklist_items c SET\n            title = COALESCE($3, c.title),\n            done = COALESCE($4, c.done)\n        FROM nodes n\n        WHERE c.id = $2 AND n.id = c.node_id AND n.user_id = $1\n        RETURNING c.id, c.node_id, c.title, c.done, c.position, c.created_at\n        ",
