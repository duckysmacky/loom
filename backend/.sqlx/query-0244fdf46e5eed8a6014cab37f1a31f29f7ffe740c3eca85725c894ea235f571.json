{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.id, a.ended_at, a.focus AS \"focus: NodeFocus\"\n        FROM active_periods a\n        JOIN nodes n ON n.id = a.node_id\n        WHERE a.node_id = $2 AND n.user_id = $1\n        ORDER BY a.started_at DESC, a.id DESC\n        LIMIT 1\n        ",
