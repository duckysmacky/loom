  "db_name": "PostgreSQL",
  "query": "\n        SELECT c.id, c.node_id, c.title, c.done, c.position, c.created_at\n        FROM checklist_items c\n        JOIN nodes n ON n.id = c.node_id\n        WHERE n.user_id = $1 AND c.node_id = $2\n        ORDER BY c.position, c.created_at\n        ",
