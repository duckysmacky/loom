  "query": "\n        INSERT INTO pokes (node_id, poked_at)\n        SELECT $2, COALESCE($3, now()) WHERE EXISTS (SELECT 1 FROM nodes WHERE id = $2 AND user_id = $1)\n        RETURNING id, node_id, poked_at\n        ",
